# Configuration Base de données PostgreSQL
POSTGRES_DB=agrisense
POSTGRES_USER=agrisense_user
POSTGRES_PASSWORD=changeme_in_local_env
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://agrisense_user:changeme_in_local_env@postgres:5432/agrisense

# URLs des services (réseau Docker interne)
COLLECTION_SERVICE_URL=http://collection-service:8000
PROCESSING_SERVICE_URL=http://processing-service:8000

# Configuration des seuils d'alerte (Section 5 du PRD)
THRESHOLD_TEMPERATURE_MAX=35.0
THRESHOLD_SOIL_HUMIDITY_MIN=25.0
THRESHOLD_AIR_HUMIDITY_MIN=30.0

# Configuration du simulateur IoT
SIMULATION_INTERVAL_SECONDS=5
SIMULATION_ANOMALY_PROBABILITY=0.25
HTTP_TIMEOUT_SECONDS=5.0
MAX_RETRIES=3

# Journalisation
LOG_LEVEL=INFO

